# Copie para `.env.local` (que nunca é versionado — veja o .gitignore).

# Opcional. Eleva o rate limit da API do GitHub de 60 para 5.000 req/h,
# usado pela seção de estatísticas (src/lib/github.ts).
# Crie um token FINE-GRAINED com ZERO permissões — ler dados públicos não
# exige escopo nenhum: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Recomendado. ID aleatório do FormSubmit para o formulário de contato.
# Sem ele o endpoint carrega seu e-mail em texto claro dentro do bundle JS,
# onde qualquer scraper o coleta. O ID chega no e-mail de confirmação
# que o FormSubmit envia no primeiro envio do formulário.
NEXT_PUBLIC_FORMSUBMIT_ID=
